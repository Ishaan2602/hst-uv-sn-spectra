*/cos_out_*/
*/cos_work/

# python
__pycache__/
*.py[cod]
*.pyo
.ipynb_checkpoints/

# jupyter
.jupyter/

# OS junk
.DS_Store
Thumbs.db

# secrets (TNS bot credentials etc.) -- never commit
.env
.env.*

